# Copia in .env e regola. Tutte opzionali: scegli UN modo per l'accesso AWS read-only.
# (Su EC2/ECS puoi lasciare tutto vuoto e usare il ruolo dell'istanza.)

# Porta su cui esporre la dashboard
PORT=3001

# Modalità DEMO: dati finti, ZERO connessione AWS. Per provarlo o registrare una demo.
# Mettilo a 1 e avvia: vedrai una flotta di esempio con tutti gli stati. Lascia vuoto per i dati reali.
DADAGUARD_DEMO=

# Auto-discovery: unisce i servizi trovati negli account a quelli in services.yaml (read-only).
# Attiva di default. Metti 0 se vuoi vedere SOLO la watchlist di services.yaml.
DADAGUARD_DISCOVER=1

# Opzione A — profilo da ~/.aws (montato dal docker-compose)
AWS_PROFILE=

# Opzione B — chiavi dirette
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_SESSION_TOKEN=

# Region di default per le chiamate (gli account in services.yaml possono sovrascriverla)
AWS_REGION=eu-central-1

# --- Esecuzioni: sorgente orchestratore Prefect (OPZIONALE) ---
# Serve a una cosa sola: i job lunghi (scraper) spesso NON sono cron di EventBridge, li lancia un
# orchestratore che può girare FUORI da AWS, e in quel caso non compaiono in nessuna API AWS. Con
# queste variabili la pagina Esecuzioni mostra anche i suoi flow run (in corso e finiti) e i loro log.
# Vuoto = sorgente spenta: la sezione non compare e non è un errore. Sola lettura (solo API `*/filter`).
PREFECT_API_URL=
# Auth applicativa dell'API (`utente:password`) → header Basic. In alternativa PREFECT_API_KEY (Bearer).
PREFECT_API_AUTH_STRING=
PREFECT_API_KEY=
